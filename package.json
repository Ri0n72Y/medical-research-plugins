{
  "name": "dsh-medical-research-skill-pack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH CAPN1/AML public reconstruction skill bundle and workspace runner",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": "11.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "doctor": "node scripts/cli.mjs doctor",
    "deploy": "node scripts/cli.mjs deploy web",
    "deploy:web": "node scripts/cli.mjs deploy web",
    "deploy:headless": "node scripts/cli.mjs deploy headless",
    "deploy:acp": "node scripts/cli.mjs deploy acp",
    "web": "node scripts/cli.mjs web",
    "headless:qc": "node scripts/cli.mjs headless",
    "acp": "node scripts/cli.mjs acp",
    "test": "node --test .dsh/skills/capn1-aml-public-reconstruction/tests/m1-source-cache.test.mjs .dsh/skills/capn1-aml-public-reconstruction/tests/m2-processing.test.mjs scripts/cli.test.mjs .dsh/skills/capn1-aml-public-reconstruction/tests/m3-survival.test.mjs .dsh/skills/capn1-aml-public-reconstruction/tests/m4-deg.test.mjs .dsh/skills/capn1-aml-public-reconstruction/tests/m5-enrichment.test.mjs",
    "data:prepare": "node scripts/cli.mjs prepare",
    "survival": "node scripts/cli.mjs survival",
    "deg": "node scripts/cli.mjs deg",
    "enrichment": "node scripts/cli.mjs enrichment"
  },
  "files": [
    "cordis.patch.yml",
    ".dsh/skills",
    "scripts/cli.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ri0n72Y/medical-research-plugins.git"
  },
  "packageManager": "pnpm@11.7.0"
}
